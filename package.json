{
	"name": "milhouse-cli",
	"version": "0.5.2",
	"description": "Correctness-first AI coding orchestrator: it investigates before it acts and verifies before it merges.",
	"type": "module",
	"bin": {
		"milhouse": "src/index.ts"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "bun run src/index.ts",
		"build": "bun build src/index.ts --compile --outfile dist/milhouse",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"keywords": [
		"ai",
		"claude-code",
		"codex",
		"coding-agent",
		"orchestrator",
		"verification",
		"cli"
	],
	"author": "Leonid Klarov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eizorerad/milhouse.git"
	},
	"homepage": "https://github.com/eizorerad/milhouse#readme",
	"engines": {
		"bun": ">=1.1.0"
	},
	"dependencies": {
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "^1.1.0",
		"bun-types": "^1.3.9",
		"typescript": "^5.9.3"
	}
}
